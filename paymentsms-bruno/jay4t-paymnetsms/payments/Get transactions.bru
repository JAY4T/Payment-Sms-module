meta {
  name: Get transactions
  type: http
  seq: 4
}

get {
  url: {{base_url}}/transaction?page=1&size=10
  body: json
  auth: inherit
}

params:query {
  page: 1
  size: 10
}

body:json {
  {
    "amount": 10,
    "currency": "KES",
    "method": "M-PESA",
    "phoneNumber": "254794649026",
    "walletId": 1,
    "narration": "Buy ticket for match: Team A vs Team B"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
