meta {
  name: Create wallet
  type: http
  seq: 1
}

post {
  url: {{base_url}}/intasend/wallet
  body: json
  auth: inherit
}

body:json {
  {
    "name": "Ligiopen tickets",
    "description": "Wallet for ticket payments",
    "isSystemWallet": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
