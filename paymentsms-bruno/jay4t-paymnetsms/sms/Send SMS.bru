meta {
  name: Send SMS
  type: http
  seq: 1
}

post {
  url: {{base_url}}/sms/send
  body: json
  auth: inherit
}

body:json {
  {
    "sender": "LigiOpen",
    "recipient": "0753031632",
    "service": "LIGIOPEN",
    "message": "Don't miss the big match! [Team A] takes on [Team B] this Saturday at 4:00 PM. Venue: [City Stadium]. Get your tickets now: https://ligiopen.com/tickets. See you there!"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## Send SMS

  Bruno: `sms/Send SMS`

  `sender` must exactly match a shortcode registered via `admin/Create Celcom Sender` - each
  shortcode (`LigiOpen`, `KaaKazini`, etc.) has its own Celcom API key, looked up by this field.
  Sending with an unregistered or revoked `sender` fails with a clear error naming it instead of
  going out.
}
